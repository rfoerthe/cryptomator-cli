  "cards": [
    {
      "dot": "cyan",
      "title": "Four crates, one binary",
      "items": [
        "cryptomator-core: std only, no tokio, no unsafe code",
        "cryptomator-mount: FUSE and WebDAV behind cargo features",
        "crypto: a thin clap shell that xtask turns into 43 manpages"
      ]
    },
    {
      "dot": "emerald",
      "title": "Process model",
      "items": [
        "unlock spawns one detached daemon per vault",
        "lock, stats and events are round trips on its socket",
        "fs, health and migrate open the vault without a daemon"
      ]
    },
    {
      "dot": "rose",
      "title": "Compatibility surfaces",
      "items": [
        "settings.json is shared; unknown keys survive a write",
        "Keychain items follow the desktop schema",
        "The 64-byte key never enters argv, the environment or a file"
      ]
    }
  ]
