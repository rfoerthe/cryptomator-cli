  "cards": [
    {
      "dot": "rose",
      "title": "Where the key lives",
      "items": [
        "scrypt runs in the parent, so a wrong passphrase fails at once",
        "The key travels base64 as the first message on the socket",
        "Both copies are Zeroizing buffers and are wiped after the send"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why the daemon greets first",
      "items": [
        "The client checks magic and protocol 1 before it sends anything",
        "A socket left by another program is never fed a vault key",
        "A missing socket is retried every 100 ms; both failures exit 10"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ordering guarantees",
      "items": [
        "Hub vault, bad mounter and missing keychain fail before the prompt",
        "Write order is pid, then socket, then run info",
        "The answer waits until the mount point is in the mount table"
      ]
    }
  ]
